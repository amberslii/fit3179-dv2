{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Five documented product locations. Fixed-size category-coloured points; selection is an outline. Inset A shows Heathmont and Ferntree Gully. Its exact viewport is inverted to a geographic footprint on the main map.",
  "width": 650,
  "height": 500,
  "padding": 0,
  "autosize": "none",
  "background": "#faf9f4",
  "config": {
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "fill": "#243440"
    },
    "style": {
      "guide-label": {
        "font": "Arial"
      },
      "guide-title": {
        "font": "Arial"
      }
    }
  },
  "signals": [
    {
      "name": "selectedProduct",
      "value": "P14"
    },
    {
      "name": "groupColors",
      "value": [
        "#2c67c9",
        "#36b4af",
        "#e971aa",
        "#f3cb43"
      ]
    },
    {
      "name": "compact",
      "update": "width<480"
    },
    {
      "name": "iw",
      "update": "compact?width-24:min(280,width*.45)"
    },
    {
      "name": "ih",
      "update": "compact?214:220"
    },
    {
      "name": "bodyWidth",
      "update": "iw-2"
    },
    {
      "name": "bodyHeight",
      "update": "ih-33"
    },
    {
      "name": "corner0",
      "update": "invert('inset',[0,0])"
    },
    {
      "name": "corner1",
      "update": "invert('inset',[bodyWidth,0])"
    },
    {
      "name": "corner2",
      "update": "invert('inset',[bodyWidth,bodyHeight])"
    },
    {
      "name": "corner3",
      "update": "invert('inset',[0,bodyHeight])"
    },
    {
      "name": "footprint",
      "update": "{type:'LineString',coordinates:[corner0,corner1,corner2,corner3,corner0]}"
    },
    {
      "name": "locatorBounds",
      "update": "geoBounds('map',footprint)"
    },
    {
      "name": "connector",
      "update": "'M'+(12+iw)+','+(12+ih-8)+(compact?'L'+(width-5)+','+(12+ih+4)+'L'+(width-5)+','+(locatorBounds[0][1]-18):'')+'L'+locatorBounds[1][0]+','+locatorBounds[0][1]"
    },
    {
      "name": "tagX",
      "update": "min(width-145,locatorBounds[1][0]+12)"
    },
    {
      "name": "tagY",
      "update": "locatorBounds[1][1]+14"
    },
    {
      "name": "scaleOrigin",
      "update": "invert('inset',[14,bodyHeight-12])"
    },
    {
      "name": "scaleLongitudeStep",
      "update": "5/(6371*cos(scaleOrigin[1]*PI/180))*180/PI"
    },
    {
      "name": "scaleEnd",
      "update": "scale('inset',[scaleOrigin[0]+scaleLongitudeStep,scaleOrigin[1]])[0]"
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "data/processed/chapter3/states.json"
    },
    {
      "name": "sa4",
      "url": "data/processed/chapter3/sa4.json"
    },
    {
      "name": "products",
      "url": "data/processed/chapter3/products.json"
    },
    {
      "name": "land",
      "source": "states",
      "transform": [
        {
          "type": "geopath",
          "projection": "map"
        }
      ]
    },
    {
      "name": "mainProducts",
      "source": "products",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.number<=3"
        },
        {
          "type": "geopoint",
          "projection": "map",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "insetProducts",
      "source": "products",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.number>=4"
        },
        {
          "type": "geopoint",
          "projection": "inset",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "mainInsetProducts",
      "source": "products",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.number>=4"
        },
        {
          "type": "geopoint",
          "projection": "map",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "insetLand",
      "source": "sa4",
      "transform": [
        {
          "type": "geopath",
          "projection": "inset"
        }
      ]
    },
    {
      "name": "locator",
      "values": [
        {}
      ],
      "transform": [
        {
          "type": "formula",
          "as": "geo",
          "expr": "footprint"
        },
        {
          "type": "geopath",
          "field": "geo",
          "projection": "map"
        }
      ]
    },
    {
      "name": "stateLabels",
      "values": [
        {
          "name": "QLD",
          "lon": 147,
          "lat": -25.2
        },
        {
          "name": "NSW",
          "lon": 146.8,
          "lat": -32.1
        },
        {
          "name": "SA",
          "lon": 137.7,
          "lat": -32.5
        },
        {
          "name": "VIC",
          "lon": 145.6,
          "lat": -36.9
        }
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "width>=400||datum.name!=='VIC'"
        },
        {
          "type": "geopoint",
          "projection": "map",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    }
  ],
  "scales": [],
