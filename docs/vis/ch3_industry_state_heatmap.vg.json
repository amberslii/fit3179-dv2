{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Industry-by-state business shares, filtered to one product group. Each row uses its own eight-state/territory total. Common 0–50% scale; highest values in each row are underlined.",
  "width": 600,
  "height": 330,
  "padding": 0,
  "autosize": "none",
  "background": "#faf9f4",
  "config": {
    "text": {
      "font": "Arial",
      "fontSize": 12,
      "fill": "#243440"
    },
    "style": {
      "guide-label": {
        "font": "Arial"
      },
      "guide-title": {
        "font": "Arial"
      }
    }
  },
  "signals": [
    {
      "name": "group",
      "value": 0
    },
    {
      "name": "selectedState",
      "value": "NSW"
    },
    {
      "name": "selectedIndustry",
      "value": "117"
    },
    {
      "name": "palettes",
      "value": [
        [
          "#edf3ff",
          "#164c9d"
        ],
        [
          "#e7f6f3",
          "#11655e"
        ],
        [
          "#fff0f5",
          "#99345e"
        ],
        [
          "#fff8da",
          "#7d5a00"
        ]
      ]
    },
    {
      "name": "groupColors",
      "value": [
        "#2c67c9",
        "#36b4af",
        "#e971aa",
        "#f3cb43"
      ]
    },
    {
      "name": "labelWidth",
      "update": "width<400?88:136"
    },
    {
      "name": "rowHeight",
      "update": "width<400?52:60"
    },
    {
      "name": "rowCount",
      "update": "length(data('industries'))"
    },
    {
      "name": "gridBottom",
      "update": "30+rowHeight*rowCount"
    }
  ],
  "data": [
    {
      "name": "allIndustries",
      "url": "data/processed/chapter3/industries.json"
    },
    {
      "name": "industries",
      "source": "allIndustries",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group===group"
        }
      ]
    },
    {
      "name": "allCells",
      "url": "data/processed/chapter3/heatmap-cells.json"
    },
    {
      "name": "cells",
      "source": "allCells",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group===group"
        }
      ]
    },
    {
      "name": "states",
      "values": [
        {
          "id": "NSW"
        },
        {
          "id": "VIC"
        },
        {
          "id": "QLD"
        },
        {
          "id": "WA"
        },
        {
          "id": "SA"
        },
        {
          "id": "TAS"
        },
        {
          "id": "NT"
        },
        {
          "id": "ACT"
        }
      ]
    },
    {
      "name": "legend",
      "values": [
        {
          "share": 0,
          "i": 0
        },
        {
          "share": 0.1,
          "i": 1
        },
        {
          "share": 0.2,
          "i": 2
        },
        {
          "share": 0.3,
          "i": 3
        },
        {
          "share": 0.4,
          "i": 4
        },
        {
          "share": 0.5,
          "i": 5
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "columns",
      "type": "band",
      "domain": {
        "data": "states",
        "field": "id"
      },
      "range": [
        {
          "signal": "labelWidth"
        },
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.06,
      "paddingOuter": 0
    },
    {
      "name": "rows",
      "type": "band",
      "domain": {
        "data": "industries",
        "field": "code"
      },
      "range": [
        30,
        {
          "signal": "gridBottom"
        }
      ],
      "paddingInner": 0.04
    },
    {
      "name": "heatColor",
      "type": "linear",
      "domain": [
        0,
        0.5
      ],
      "range": {
        "signal": "palettes[group]"
      },
      "interpolate": "lab",
      "clamp": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "industryHeader",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 14
          },
          "text": {
            "value": "Industry"
          },
          "fill": {
            "value": "#243440"
          },
          "fontSize": {
            "signal": "width<400?10:12"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "stateHeaders",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "columns",
            "field": "id",
            "band": 0.5
          },
          "y": {
            "value": 14
          },
          "text": {
            "field": "id"
          },
          "fill": {
            "value": "#243440"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "signal": "width<400?10:12"
          },
          "fontWeight": {
            "signal": "datum.id===selectedState?700:400"
          }
        }
      }
    },
    {
      "type": "rule",
      "name": "selectedColumn",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "columns",
            "field": "id",
            "offset": 2
          },
          "x2": {
            "scale": "columns",
            "field": "id",
            "band": 1,
            "offset": -2
          },
          "y": {
            "value": 21
          },
          "stroke": {
            "value": "#243440"
          },
          "opacity": {
            "signal": "datum.id===selectedState?1:0"
          }
        }
      },
      "interactive": false
    },
    {
      "type": "rect",
      "name": "industryColor",
      "from": {
        "data": "industries"
      },
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "width": {
            "value": 4
          },
          "y": {
            "scale": "rows",
            "field": "code"
          },
          "height": {
            "scale": "rows",
            "band": 1
          },
          "fill": {
            "signal": "groupColors[group]"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "industryLabels",
      "from": {
        "data": "industries"
      },
      "encode": {
        "update": {
          "x": {
            "value": 10
          },
          "y": {
            "scale": "rows",
            "field": "code",
            "band": 0.5
          },
          "text": {
            "signal": "width<400?datum.narrowLines:datum.lines"
          },
          "fill": {
            "value": "#243440"
          },
          "fontSize": {
            "signal": "width<400?10:12"
          },
          "lineHeight": {
            "signal": "width<400?13:16"
          },
          "baseline": {
            "value": "middle"
          },
          "limit": {
            "signal": "labelWidth-15"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "heatCells",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "columns",
            "field": "state"
          },
          "width": {
            "scale": "columns",
            "band": 1
          },
          "y": {
            "scale": "rows",
            "field": "code"
          },
          "height": {
            "scale": "rows",
            "band": 1
          },
          "fill": {
            "scale": "heatColor",
            "field": "share"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "datum.name+' · '+datum.state+': '+format(datum.n,',')+' businesses; '+format(datum.share,'.1%')+' of this industry’s eight-state total'"
          },
          "description": {
            "signal": "datum.name+' · '+datum.state+': '+format(datum.n,',')+' businesses; '+format(datum.share,'.1%')+' of this industry’s eight-state total'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "heatValues",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "columns",
            "field": "state",
            "band": 0.5
          },
          "y": {
            "scale": "rows",
            "field": "code",
            "band": 0.5
          },
          "text": {
            "field": "label"
          },
          "fill": {
            "signal": "luminance(scale('heatColor',datum.share))>.179?'#000000':'#ffffff'"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "width<400?10:13"
          },
          "fontWeight": {
            "signal": "datum.maximum?600:400"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "datum.name+' · '+datum.state+': '+format(datum.n,',')+' businesses; '+format(datum.share,'.1%')"
          },
          "description": {
            "signal": "datum.name+' · '+datum.state+': '+format(datum.n,',')+' businesses; '+format(datum.share,'.1%')"
          }
        }
      }
    },
    {
      "type": "rule",
      "name": "maximumUnderlines",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "columns",
            "field": "state",
            "band": 0.5,
            "offset": -11
          },
          "x2": {
            "scale": "columns",
            "field": "state",
            "band": 0.5,
            "offset": 11
          },
          "y": {
            "scale": "rows",
            "field": "code",
            "band": 0.5,
            "offset": 10
          },
          "stroke": {
            "signal": "luminance(scale('heatColor',datum.share))>.179?'#000000':'#ffffff'"
          },
          "opacity": {
            "signal": "datum.maximum?1:0"
          }
        }
      },
      "interactive": false
    },
    {
      "type": "rect",
      "name": "selectedCell",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "columns",
            "field": "state",
            "offset": 2
          },
          "x2": {
            "scale": "columns",
            "field": "state",
            "band": 1,
            "offset": -2
          },
          "y": {
            "scale": "rows",
            "field": "code",
            "offset": 2
          },
          "y2": {
            "scale": "rows",
            "field": "code",
            "band": 1,
            "offset": -2
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "signal": "luminance(scale('heatColor',datum.share))>.179?'#000000':'#ffffff'"
          },
          "strokeWidth": {
            "value": 2
          },
          "opacity": {
            "signal": "datum.code===selectedIndustry&&datum.state===selectedState?1:0"
          }
        }
      },
      "interactive": false
    },
    {
      "type": "text",
      "name": "heatLegendTitle",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "gridBottom+29"
          },
          "text": {
            "value": "Light → dark: state share of this industry"
          },
          "fill": {
            "value": "#596773"
          },
          "fontSize": {
            "signal": "width<400?10:11"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "heatLegendSwatches",
      "from": {
        "data": "legend"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.i*width/6"
          },
          "y": {
            "signal": "gridBottom+42"
          },
          "width": {
            "signal": "width<400?13:20"
          },
          "height": {
            "value": 12
          },
          "fill": {
            "scale": "heatColor",
            "field": "share"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "heatLegendLabels",
      "from": {
        "data": "legend"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.i*width/6+(width<400?17:24)"
          },
          "y": {
            "signal": "gridBottom+52"
          },
          "text": {
            "signal": "format(datum.share,'.0%')"
          },
          "fill": {
            "value": "#596773"
          },
          "fontSize": {
            "signal": "width<400?10:11"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "heatLegendNote",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "gridBottom+76"
          },
          "text": {
            "value": "Same 0–50% scale. Row maxima are underlined."
          },
          "fill": {
            "value": "#596773"
          },
          "fontSize": {
            "signal": "width<400?10:11"
          }
        }
      }
    }
  ]
}
